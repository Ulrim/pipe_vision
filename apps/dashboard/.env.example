# AIVIS dashboard — frontend env (Vite). Copy to .env.local for dev.
# Base URL of the FastAPI backend (§7.4). Empty -> same-origin (nginx proxy).
VITE_API_BASE=http://localhost:8000
# Base URL of the MES service (services/mes, port 8100). Unset -> same host :8100
# on SPA ports, "/mes-api" behind an 80/443 reverse proxy.
# VITE_MES_API_BASE=http://localhost:8100
# 실시간 현황 카드의 "작업자 화면" 링크(클라우드: Vercel HMI 주소). 비우면 같은 호스트 :5173.
# VITE_HMI_URL=https://aivis-hmi.vercel.app
#
# 클라우드(Vercel) 운영값 예시 — deploy/DEPLOYMENT.md §3. VITE_* 는 빌드 때 박힌다(바꾸면 Redeploy).
#   VITE_API_BASE=https://aivis-api.onrender.com
#   VITE_MES_API_BASE=https://aivis-mes.onrender.com
#   VITE_HMI_URL=https://aivis-hmi.vercel.app
